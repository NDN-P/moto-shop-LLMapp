# Set private local login credentials before starting the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:./demo.db

# Shared default: invented catalog for reproducible evaluation and demos.
# Optional shop mode reads DATABASE_URL without writes and sends the question
# plus selected id/name/SKU/category/price/stock/minStock or inventory totals
# to the course proxy. Descriptions, suppliers, photos and history are excluded.
# Set ASSISTANT_DATA_MODE=shop only when this real-inventory disclosure is intended.
# Shop mode permits only https://llm.nat-d.uk/v1 (optional trailing slash/whitespace).
# Sample mode retains a configurable endpoint.
ASSISTANT_DATA_MODE=sample
OPENAI_BASE_URL=https://llm.nat-d.uk/v1
OPENAI_API_KEY=

# Optional full Python executable path; otherwise the app uses .venv.
# PYTHON_EXECUTABLE=
