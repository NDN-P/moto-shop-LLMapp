# Set private local login credentials before starting the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:./demo.db

# Only the invented sample catalog may be sent to the class proxy.
ASSISTANT_DATA_MODE=sample
OPENAI_BASE_URL=https://llm.nat-d.uk/v1
OPENAI_API_KEY=

# Optional full Python executable path; otherwise the app uses .venv.
# PYTHON_EXECUTABLE=
